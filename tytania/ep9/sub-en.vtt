WEBVTT

00:10.314 --> 00:16.625
[opening theme music]

01:48.369 --> 01:51.111
[theme music]

02:31.020 --> 02:34.328
[soft instrumental music]

03:21.940 --> 03:23.507
[gasps]

06:42.967 --> 06:46.536
[device beeping]

06:54.065 --> 06:56.938
[harmonic music in the
background]

08:01.176 --> 08:04.658
[panting]

09:32.136 --> 09:36.576
[sweet melodic music]

10:34.982 --> 10:36.418
[music continues]

11:05.403 --> 11:06.666
[loud thud]

11:32.561 --> 11:34.215
[screams]

11:51.406 --> 11:53.582
[loud thud]
[screams]

11:59.936 --> 12:00.850
[cracks]

12:01.024 --> 12:02.025
[screams]

12:08.379 --> 12:13.645
[dramatic interlude]

12:25.179 --> 12:26.180
[kicks]

12:41.064 --> 12:46.461
[beeping]

12:52.641 --> 12:53.685
[scoffs]

12:55.165 --> 12:57.385
[harmonic music]

15:14.739 --> 15:18.047
[melodic music]

16:21.023 --> 16:22.285
[laughs]

16:35.472 --> 16:38.345
[sweet melodic piano music]

18:43.992 --> 18:46.951
[bittersweet music]

19:46.707 --> 19:47.795
[knocks on door]

20:40.587 --> 20:43.416
[harmonic piano music]

22:26.606 --> 22:29.565
[music continues]

22:52.980 --> 22:58.594
[ending theme music]
