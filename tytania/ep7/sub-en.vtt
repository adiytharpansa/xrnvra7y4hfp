WEBVTT

00:10.445 --> 00:16.712
[opening theme music]

01:52.199 --> 01:54.766
[grunts then sighs]

02:35.720 --> 02:41.770
[alarm system ringing]

02:41.944 --> 02:43.989
[mysterious music]

06:55.980 --> 06:58.026
[emotive music]

08:01.568 --> 08:04.092
[sweet melodic music]

09:43.278 --> 09:47.543
[piano music in the background]

11:16.240 --> 11:17.241
[cocks gun]

11:25.510 --> 11:26.555
[beeps]

14:59.333 --> 15:01.465
[cold music]

17:48.589 --> 17:50.417
[laughing]

19:17.460 --> 19:18.679
[laughs]

19:23.336 --> 19:24.467
[chuckles]

19:29.429 --> 19:30.430
[sighs]

19:54.802 --> 19:57.370
[laughing]

19:57.544 --> 20:00.286
[poignant music]

20:03.202 --> 20:04.203
[sighs]

20:38.715 --> 20:44.895
[alarm system beeping]

20:51.162 --> 20:53.687
[dramatic music]

21:19.452 --> 21:21.280
[explosions]

21:22.324 --> 21:25.153
[explosions]

21:54.313 --> 21:56.663
[music continues]

22:12.026 --> 22:13.157
[explosion]

22:24.952 --> 22:30.610
[cheering and celebrating]

22:36.311 --> 22:38.487
[soft harmonic music]

22:53.067 --> 22:59.073
[ending theme music]
