WEBVTT

00:10.532 --> 00:16.494
[opening theme music]

01:53.722 --> 01:55.680
[dramatic music]

02:11.479 --> 02:12.784
[door opens]

02:29.540 --> 02:30.541
[music ends]

03:08.623 --> 03:11.495
[men laughing]

03:22.419 --> 03:28.469
[crying]

03:34.039 --> 03:36.085
[soft instrumental music]

05:50.132 --> 05:52.917
[ethereal music]

06:36.396 --> 06:37.919
[slaps]
[groans]

06:54.022 --> 06:57.329
[slaps then kicks]

07:18.263 --> 07:20.483
[soft piano music]

09:08.983 --> 09:12.726
[harmonic music]

10:05.822 --> 10:09.434
[dog barking]

10:09.609 --> 10:12.742
[snoring]

10:12.916 --> 10:14.788
[door opens]

10:14.962 --> 10:19.053
[continues snoring]

10:31.021 --> 10:33.415
[soft piano music]

11:17.807 --> 11:19.069
[cocks gun]

11:19.243 --> 11:21.158
[mysterious music]

12:30.445 --> 12:31.576
[door opens]
[dramatic music]

13:28.155 --> 13:30.592
[gunshots]
[groan]

13:31.811 --> 13:33.073
[melodic music]

14:11.285 --> 14:12.286
[yells]

14:41.576 --> 14:47.756
[police sirens wailing]

15:30.494 --> 15:32.844
[suspenseful music]

15:44.247 --> 15:47.207
[police sirens wailing]

16:39.911 --> 16:43.219
[soft bittersweet music]

17:24.869 --> 17:31.702
[police sirens wailing]

17:37.621 --> 17:40.711
[harmonic music]

19:05.796 --> 19:06.841
[groans]

20:38.585 --> 20:41.805
[coughing]
[laughing]

21:15.752 --> 21:16.753
[gasps]

22:00.101 --> 22:02.886
[harmonic music]

22:53.023 --> 22:58.594
[ending theme music]
