WEBVTT

00:10.445 --> 00:16.755
[opening theme music]

01:38.620 --> 01:45.366
[crying]

02:03.601 --> 02:06.517
[continues crying]

04:40.584 --> 04:43.500
[sweet melodic music]

07:32.756 --> 07:36.194
[soft slow music]

08:01.045 --> 08:03.395
[soft guitar music]

08:16.583 --> 08:17.627
[gunshots]

08:17.801 --> 08:20.195
[yelling]

11:03.750 --> 11:06.622
[pop music playing from player]
[humming]

11:34.215 --> 11:35.738
[yells]

11:36.086 --> 11:37.174
[groans]

11:56.759 --> 11:58.848
[dramatic music]

14:09.065 --> 14:12.416
[suspenseful music]

14:56.678 --> 14:57.722
[chuckles]

15:02.989 --> 15:04.773
[door opens]

16:41.478 --> 16:42.958
[shatter]

16:43.524 --> 16:47.963
[laughing]

17:08.636 --> 17:12.118
[mysterious music]

17:22.954 --> 17:29.961
[gunfire]

18:32.546 --> 18:36.332
[gasps then groans]

19:54.497 --> 19:57.587
[sad violin music]

22:53.023 --> 22:59.421
[ending theme music]
