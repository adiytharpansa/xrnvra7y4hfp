WEBVTT

00:10.097 --> 00:16.277
[opening theme music]

01:39.621 --> 01:41.623
[mysterious music]

01:46.889 --> 01:52.199
[footsteps approaching]

02:09.781 --> 02:11.043
[music continues]

02:31.368 --> 02:33.153
[knocks on door then door opens]

03:06.229 --> 03:08.449
[soft instrumental music]

05:13.313 --> 05:15.924
[bittersweet music]

07:22.964 --> 07:24.444
[suspenseful music]

10:30.064 --> 10:32.414
[dramatic music]

12:06.900 --> 12:08.075
[screams]

14:13.243 --> 14:18.596
[gasping]

14:18.770 --> 14:19.946
[screams]

14:20.120 --> 14:21.164
[groans]

14:31.435 --> 14:38.355
[all groaning]

14:43.578 --> 14:47.408
[continue groaning]

15:21.572 --> 15:23.009
[heavy sighs]

15:35.456 --> 15:37.197
[chuckles]

16:30.206 --> 16:34.036
[soft slow violin music]

17:38.666 --> 17:43.497
[birds chirping]

18:13.135 --> 18:14.484
[chuckles]

19:05.231 --> 19:06.145
[gasps]

19:06.319 --> 19:09.583
[groaning]

19:39.265 --> 19:40.440
[doorbell rings]

19:58.980 --> 20:00.503
[car accelerates]

22:53.023 --> 23:00.030
[ending theme music]
