WEBVTT

00:10.532 --> 00:16.842
[opening theme music]

01:46.715 --> 01:48.804
[knocks on door then door opens]

02:10.434 --> 02:11.566
[chuckles]

02:25.101 --> 02:28.148
[mysterious music]

08:07.008 --> 08:09.576
[unhappy shouting]

08:57.188 --> 09:00.975
[mysterious music]

09:25.129 --> 09:27.958
[gate opening]

09:41.450 --> 09:43.757
[all exclaim]

09:43.931 --> 09:45.585
[music continues]

11:08.189 --> 11:10.104
[door opens]

12:56.210 --> 13:00.780
[explosions]

13:06.655 --> 13:08.570
[cannons shot]

13:13.618 --> 13:15.359
[gunshots]

13:15.533 --> 13:16.708
[action music]

14:00.491 --> 14:05.845
[gunshots]

14:29.433 --> 14:30.347
[gunshots]

14:30.521 --> 14:31.871
[music continues]

15:25.185 --> 15:26.099
[gunshots]

15:26.273 --> 15:28.144
[explosions]

15:52.038 --> 15:53.039
[man groans]

17:17.732 --> 17:21.127
[laughing]

18:05.519 --> 18:08.522
[laughing]

18:15.181 --> 18:16.182
[gunshot]

18:17.879 --> 18:18.923
[screams]

18:50.216 --> 18:53.741
[gunshots]

18:53.915 --> 18:56.265
[yelling]

19:38.133 --> 19:39.830
[explosion]

20:00.242 --> 20:04.159
[emotional guitar music]
[crying softly]

21:04.741 --> 21:05.655
[door opens]

21:05.829 --> 21:12.662
[panting]

21:24.761 --> 21:26.067
[gasps]

21:32.987 --> 21:36.164
[raining]

21:43.258 --> 21:50.178
[crying then screaming]

22:01.711 --> 22:05.236
[gloomy music]

22:53.023 --> 22:59.029
[ending theme music]
